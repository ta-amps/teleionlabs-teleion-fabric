# Names only. Copy to .env (gitignored) and fill in values locally; never commit real keys.

# Meta Model API (Standard mode: muse-spark-1.3, muse-wonder-1.0, SAM 3.1)
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1

# Official Partner Inference: Muse Spark Open on Baseten Model APIs / Fireworks AI / Together
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026
FIREWORKS_API_KEY=
TOGETHER_API_KEY=

# Modal Serverless GPU (Muse Glimmer 30B QLoRA / DoRA / Iterative-RPO)
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=

# Teleion Fabric and its model shim. The variable names are kept for existing scripts.
TESSERA_URL=https://fabric.teleionlabs.com
HERMA_URL=https://shim.teleionlabs.com
